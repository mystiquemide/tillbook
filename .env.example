# Monad mainnet
NEXT_PUBLIC_CHAIN_ID=143
NEXT_PUBLIC_RPC_URL=https://rpc.monad.xyz
# Server only: event reads. Must allow 1,000-block eth_getLogs ranges.
RPC_LOGS_URL=https://rpc3.monad.xyz
# Server only: contract reads (e.g. https://monad-mainnet.g.alchemy.com/v2/<key>). Falls back to the public RPC.
SERVER_RPC_URL=
# Server only: Envio HyperIndex GraphQL endpoint for payment and advance history. Falls back to RPC log scans.
ENVIO_GRAPHQL_URL=

# Privy app ID for email, Google and wallet sign-in. Without it the app uses browser wallets only.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_EXPLORER_URL=

# Deployed contracts
NEXT_PUBLIC_TOKEN_ADDRESS=0x754704Bc059F8C67012fEd69BC8A327a5aafb603
NEXT_PUBLIC_POOL_ADDRESS=0x317E89b89aeE6af8c1fD6AaceF06daaD733EFFaE
NEXT_PUBLIC_ROUTER_ADDRESS=0x380A8e5A6BbE708E17397f3c31Cb806bfd920853
NEXT_PUBLIC_POOL_DEPLOY_BLOCK=112997981

# Server only: signs advance offers. Never expose to the client.
UNDERWRITER_PRIVATE_KEY=

# Deploy and seed scripts only
DEPLOYER_PRIVATE_KEY=
